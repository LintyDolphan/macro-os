NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin key. Required for in-app account deletion.
# Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only catalog import keys. Do not expose these with NEXT_PUBLIC_.
# USDA FoodData Central can use DEMO_KEY for low-volume testing, but production should use a real key.
USDA_FDC_API_KEY=

# Optional exercise enrichment provider. If unset, the exercise lookup endpoint returns an empty list.
API_NINJAS_API_KEY=
